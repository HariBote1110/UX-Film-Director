{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PositionKeyframe",
  "type": "object",
  "properties": {
    "easing": {
      "$ref": "#/$defs/Easing",
      "default": "linear"
    },
    "frame_offset": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "x": {
      "type": "number",
      "format": "float"
    },
    "y": {
      "type": "number",
      "format": "float"
    }
  },
  "required": [
    "frame_offset",
    "x",
    "y"
  ],
  "$defs": {
    "Easing": {
      "type": "string",
      "enum": [
        "linear",
        "easeInSine",
        "easeOutSine",
        "easeInOutSine",
        "easeInQuad",
        "easeOutQuad",
        "easeInOutQuad",
        "easeInCubic",
        "easeOutCubic",
        "easeInOutCubic",
        "easeInQuart",
        "easeOutQuart",
        "easeInOutQuart",
        "easeInQuint",
        "easeOutQuint",
        "easeInOutQuint",
        "easeInExpo",
        "easeOutExpo",
        "easeInOutExpo",
        "easeInCirc",
        "easeOutCirc",
        "easeInOutCirc",
        "easeInBack",
        "easeOutBack",
        "easeInOutBack",
        "easeInElastic",
        "easeOutElastic",
        "easeInOutElastic",
        "easeInBounce",
        "easeOutBounce",
        "easeInOutBounce"
      ]
    }
  }
}
