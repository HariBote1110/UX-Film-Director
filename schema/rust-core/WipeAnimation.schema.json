{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WipeAnimation",
  "type": "object",
  "properties": {
    "edge": {
      "$ref": "#/$defs/WipeEdge"
    },
    "effect_index": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "reverse": {
      "type": "boolean"
    }
  },
  "required": [
    "effect_index",
    "edge",
    "reverse"
  ],
  "$defs": {
    "WipeEdge": {
      "type": "string",
      "enum": [
        "left",
        "right",
        "top",
        "bottom"
      ]
    }
  }
}
