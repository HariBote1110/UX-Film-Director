{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RandomLineExObjectFields",
  "description": "`random_line_ex` kind (`src/types.ts` の `RandomLineExObject`) の kind\n固有フィールド。編集モデル型は\n`BaseObject & RandomLineExObjectFields & { type: 'random_line_ex' }`\nとして組み立てる。\n\n`width`/`height` は `randomLineExObjectFactory.ts` の\n`buildAviUtlRandomLineExObject` の固定リテラル (800x450) をそのまま\n採用する（プロジェクトサイズ依存の計算値ではない）。",
  "type": "object",
  "properties": {
    "height": {
      "type": "number",
      "format": "float"
    },
    "lineColour": {
      "type": "string"
    },
    "lineCount": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "lineWidth": {
      "type": "number",
      "format": "float"
    },
    "noiseCellSize": {
      "type": "number",
      "format": "float"
    },
    "seed": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "threshold": {
      "type": "number",
      "format": "float"
    },
    "width": {
      "type": "number",
      "format": "float"
    },
    "widthVariance": {
      "type": "number",
      "format": "float"
    }
  },
  "required": [
    "width",
    "height",
    "lineCount",
    "lineWidth",
    "threshold",
    "noiseCellSize",
    "widthVariance",
    "seed",
    "lineColour"
  ]
}
