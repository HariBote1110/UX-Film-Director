        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/PathPoint"
      }
    },
    "name": {
      "type": "string"
    },
    "offset": {
      "type": [
        "number",
        "null"
      ],
      "format": "float"
    },
    "opacity": {
      "type": "number",
      "format": "float"
    },
    "rotation": {
      "type": "number",
      "format": "float"
    },
    "scaleX": {
      "type": "number",
      "format": "float"
    },
    "scaleY": {
      "type": "number",
      "format": "float"
    },
    "shadow": {
      "anyOf": [
