{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CircularArrowObjectFields",
  "description": "`circular_arrow` kind (`src/types.ts` の `CircularArrowObject`) の kind\n固有フィールド。編集モデル型は\n`BaseObject & CircularArrowObjectFields & { type: 'circular_arrow' }`\nとして組み立てる。\n\n`width`/`height` は `circularArrowObjectFactory.ts` の\n`buildAviUtlCircularArrowObject` の固定リテラル (200x200) をそのまま\n採用する（プロジェクトサイズ依存の計算値ではない）。",
  "type": "object",
  "properties": {
    "angleDegrees": {
      "type": "number",
      "format": "float"
    },
    "arrowColour": {
      "type": "string"
    },
    "centreAngleDegrees": {
      "type": "number",
      "format": "float"
    },
    "flipHorizontal": {
      "type": "boolean"
    },
    "flipVertical": {
      "type": "boolean"
    },
    "headShape": {
      "type": "string"
    },
    "headSize": {
      "type": "number",
      "format": "float"
    },
    "height": {
      "type": "number",
      "format": "float"
    },
    "lineWidth": {
      "type": "number",
      "format": "float"
    },
    "radius": {
      "type": "number",
      "format": "float"
    },
    "showTailHead": {
      "type": "boolean"
    },
    "width": {
      "type": "number",
      "format": "float"
    }
  },
  "required": [
    "width",
    "height",
    "radius",
    "lineWidth",
    "headSize",
    "angleDegrees",
    "centreAngleDegrees",
    "headShape",
    "showTailHead",
    "flipVertical",
    "flipHorizontal",
    "arrowColour"
  ]
}
