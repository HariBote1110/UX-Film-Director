{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vec3",
  "description": "3D ステージ用ワールド座標。`src/types.ts` の `Vec3` と同形。",
  "type": "object",
  "properties": {
    "x": {
      "type": "number",
      "format": "float"
    },
    "y": {
      "type": "number",
      "format": "float"
    },
    "z": {
      "type": "number",
      "format": "float"
    }
  },
  "required": [
    "x",
    "y",
    "z"
  ]
}
