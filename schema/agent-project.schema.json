{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ux-film-director.local/schema/agent-project.schema.json",
  "title": "UXFD Agent Project Recipe",
  "description": "AIエージェントが public/agent-projects/*.json に書くレシピの形式。実行時の唯一の正となる検証ロジックは src/agentProject/agentProject.ts の parseAgentProjectSpec で、このスキーマはエディタ補完・AIエージェントの自己検証を助けるための参考情報。両者が乖離した場合は agentProject.ts を信頼すること。",
  "type": "object",
  "required": ["version", "project", "layers", "objects"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "project": {
      "type": "object",
      "required": ["width", "height", "fps", "sampleRate", "duration"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "fps": { "type": "number", "exclusiveMinimum": 0 },
        "sampleRate": { "type": "number", "exclusiveMinimum": 0 },
        "duration": { "type": "number", "exclusiveMinimum": 0 },
        "editorMode": { "type": "string", "enum": ["2d", "3d"] }
      }
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "visible": { "type": "boolean" },
          "locked": { "type": "boolean" }
        }
      },
      "description": "配列の並び順がそのままレイヤー番号(z順)になる。先頭ほど背面、末尾ほど前面。objects[].layer はここに定義した id を参照する。"
    },
    "objects": {
      "type": "array",
      "items": { "$ref": "#/$defs/agentObject" }
    }
  },
  "$defs": {
    "colour": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "gradient": {
      "type": "object",
      "required": ["type", "colours", "stops"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["linear", "radial"] },
        "colours": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/colour" }
        },
        "stops": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "direction": { "type": "number", "description": "度数(0-360)。linearの角度、radialは未使用でも指定可。" }
      },
      "description": "colours と stops は同じ件数にすること。stops[i] は colours[i] の位置(0-1)。"
    },
    "filter": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "blur" },
        "strength": { "type": "number", "default": 20, "description": "ぼかしの強さ(px相当)。値が大きいほど輪郭がにじむ。ハードエッジの発光/ハロー表現に使う。" },
        "quality": { "type": "number", "default": 2, "description": "Pixi BlurFilterの品質(1-4)。大きいほど滑らかだが重い。" }
      },
      "description": "現状 blur のみ対応。他のフィルター種別(fade/wipe等)はレシピ経由では未対応。"
    },
    "baseObject": {
      "type": "object",
      "required": ["id", "kind", "layer", "start", "duration"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "description": "レシピ内で一意なID。" },
        "layer": { "type": "string", "minLength": 1, "description": "layers[].id への参照。" },
        "name": { "type": "string" },
        "start": { "type": "number", "minimum": 0, "description": "秒。" },
        "duration": { "type": "number", "exclusiveMinimum": 0, "description": "秒。" },
        "x": { "type": "number", "description": "プロジェクトピクセル。左上原点。省略時はproject中央。" },
        "y": { "type": "number", "description": "プロジェクトピクセル。左上原点。省略時はproject中央。" },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "rotation": { "type": "number", "description": "度数。" },
        "scaleX": { "type": "number" },
        "scaleY": { "type": "number" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "to": {
          "type": "object",
          "required": ["x", "y"],
          "additionalProperties": false,
          "properties": { "x": { "type": "number" }, "y": { "type": "number" } },
          "description": "指定するとx/yからto.x/to.yへ位置アニメーションする。"
        },
        "easing": {
          "type": "string",
          "enum": ["linear", "easeInCubic", "easeOutCubic", "easeInOutCubic"]
        },
        "filters": {
          "type": "array",
          "items": { "$ref": "#/$defs/filter" }
        }
      }
    },
    "agentObject": {
      "oneOf": [
        {
          "allOf": [{ "$ref": "#/$defs/baseObject" }],
          "type": "object",
          "required": ["kind", "shape", "fill"],
          "properties": {
            "kind": { "const": "shape" },
            "shape": {
              "type": "string",
              "enum": ["rect", "rounded_rect", "circle", "ellipse", "triangle", "star", "pentagon", "diamond", "arrow", "heart", "cross"]
            },
            "fill": { "$ref": "#/$defs/colour" },
            "cornerRadius": { "type": "number", "minimum": 0 },
            "gradient": { "$ref": "#/$defs/gradient" }
          }
        },
        {
          "allOf": [{ "$ref": "#/$defs/baseObject" }],
          "type": "object",
          "required": ["kind", "text"],
          "properties": {
            "kind": { "const": "text" },
            "text": { "type": "string" },
            "fontSize": { "type": "number", "exclusiveMinimum": 0 },
            "fontFamily": { "type": "string" },
            "fill": { "$ref": "#/$defs/colour" },
            "textAlignment": { "type": "string", "enum": ["left", "centre", "right"] },
            "letterSpacing": { "type": "number" },
            "textShadow": {
              "type": "object",
              "properties": {
                "colour": { "$ref": "#/$defs/colour" },
                "offsetX": { "type": "number" },
                "offsetY": { "type": "number" },
                "blur": { "type": "number" }
              }
            }
          }
        },
        {
          "allOf": [{ "$ref": "#/$defs/baseObject" }],
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": { "const": "particle" },
            "particleCount": { "type": "number" },
            "seed": { "type": "number" },
            "spread": { "type": "number" },
            "speed": { "type": "number" },
            "size": { "type": "number" },
            "colour": { "$ref": "#/$defs/colour" },
            "lifetimeSeconds": { "type": "number" }
          }
        },
        {
          "allOf": [{ "$ref": "#/$defs/baseObject" }],
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": { "const": "dotField" },
            "dotSize": { "type": "number" },
            "columns": { "type": "number" },
            "rows": { "type": "number" },
            "foregroundColour": { "$ref": "#/$defs/colour" },
            "secondaryColour": { "$ref": "#/$defs/colour" },
            "backgroundColour": { "$ref": "#/$defs/colour" }
          }
        },
        {
          "allOf": [{ "$ref": "#/$defs/baseObject" }],
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": { "const": "shatteredSphere" },
            "colour": { "$ref": "#/$defs/colour" },
            "seed": { "type": "number" }
          }
        },
        {
          "allOf": [{ "$ref": "#/$defs/baseObject" }],
          "type": "object",
          "required": ["kind", "src"],
          "properties": {
            "kind": { "const": "image" },
            "src": { "type": "string", "minLength": 1, "description": "publicディレクトリからの相対パス(例: /icon.jpg)。" }
          }
        },
        {
          "allOf": [{ "$ref": "#/$defs/baseObject" }],
          "type": "object",
          "required": ["kind", "src"],
          "properties": {
            "kind": { "const": "video" },
            "src": { "type": "string", "minLength": 1 },
            "volume": { "type": "number", "minimum": 0, "maximum": 1, "default": 1 },
            "muted": { "type": "boolean", "default": false }
          }
        },
        {
          "allOf": [{ "$ref": "#/$defs/baseObject" }],
          "type": "object",
          "required": ["kind", "src"],
          "properties": {
            "kind": { "const": "audio" },
            "src": { "type": "string", "minLength": 1 },
            "volume": { "type": "number", "minimum": 0, "maximum": 1, "default": 1 },
            "muted": { "type": "boolean", "default": false }
          }
        }
      ]
    }
  }
}
