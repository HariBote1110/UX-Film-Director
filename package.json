{
  "name": "ux-film-director",
  "private": true,
  "version": "0.1.1-Beta-6a",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "perf": "VITE_PERF_AUTORUN=1 vite",
    "perf:agent": "VITE_PERF_AGENT_MODE=1 vite",
    "test": "vitest run",
    "build": "tsc && vite build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder",
    "preview": "vite preview",
    "rust:build:debug": "cargo build --manifest-path rust-backend/Cargo.toml",
    "rust:build:release": "cargo build --release --manifest-path rust-backend/Cargo.toml",
    "rust:run": "cargo run --manifest-path rust-backend/Cargo.toml"
  },
  "dependencies": {
    "ag-psd": "^29.0.0",
    "lucide-react": "^1.8.0",
    "pixi.js": "^8.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.2.2",
    "vite": "^5.2.0",
    "vite-plugin-electron": "^0.28.4",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^2.1.9"
  }
}
