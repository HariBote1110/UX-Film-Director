+// ── encode_research 用の一時計測（未コミット・撤去前提）──────────────────
+// backend RPC 応答の timings と main プロセスで見た RPC 壁時計を集計し、
+// encode.finish 時に stdout へサマリを出す。
+interface EncodeResearchStats {
+  count: number;
+  wallMs: number;
+  backend: Record<string, number>;
+}
+const encodeResearchStats = new Map<string, EncodeResearchStats>();
+const recordEncodeResearchCall = (method: string, wallMs: number, result: unknown) => {
+  const stats = encodeResearchStats.get(method) ?? { count: 0, wallMs: 0, backend: {} };
+  stats.count += 1;
+  stats.wallMs += wallMs;
+  const timings = (result as { timings?: Record<string, unknown> } | undefined)?.timings;
+  if (timings && typeof timings === 'object') {
+    for (const [key, value] of Object.entries(timings)) {
+      if (typeof value === 'number') stats.backend[key] = (stats.backend[key] ?? 0) + value;
+    }
+  }
+  encodeResearchStats.set(method, stats);
+};
+const dumpEncodeResearchStats = () => {
+  for (const [method, stats] of encodeResearchStats) {
+    const backend = Object.entries(stats.backend)
+      .map(([key, value]) => `${key}=${(value / stats.count).toFixed(2)}`)
+      .join(' ');
+    console.log(
+      `[encode-research] ${method} count=${stats.count} avgWallMs=${(stats.wallMs / stats.count).toFixed(2)} ${backend}`
+    );
+  }
+  encodeResearchStats.clear();
+};
+// ────────────────────────────────────────────────────────────────────────
+
